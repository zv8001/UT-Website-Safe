e":"textnode","content":"About Unknown Technologies"}]},{"name":"About Grid","classes":["about-grid"],"attributes":{"id":"i71pz"},"components":[{"name":"About Block","classes":["gjs-t-border","about-block"],"attributes":{"id":"ifjof"},"components":[{"tagName":"h3","type":"heading","name":"Subheading","classes":["subheading"],"components":[{"type":"textnode","content":"Our Mission"}]},{"tagName":"p","type":"text","name":"Paragraph","classes":["paragraph"],"attributes":{"id":"iykcq"},"components":[{"type":"textnode","content":"\n                Welcome to Unknown Technologies Corporation, founded in 1971 (lore date | actual: 2024). We are dedicated to developing clean and safe energy through experimental reactors.\n              "}]}]},{"name":"About Block","classes":["gjs-t-border","about-block"],"attributes":{"id":"ij21v"},"components":[{"tagName":"h3","type":"heading","name":"Subheading","classes":["subheading"],"components":[{"type":"textnode","content":"Community"}]},{"tagName":"p","type":"text","name":"Paragraph","classes":["paragraph"],"attributes":{"id":"i17su"},"components":[{"type":"textnode","content":"We are a Furry-owned community. All are welcome here. We pride ourselves in good moderation and having a strong connection with our community.\n                "},{"tagName":"br","void":true,"attributes":{"data-gs-ib":""}},{"tagName":"br","void":true,"attributes":{"data-gs-ib":""}},{"tagName":"span","type":"text","attributes":{"data-gs-mrk-fs":"true","id":"ibcthdq"},"components":[{"type":"textnode","content":"Not operated we may hand pick anyone that we see fit regardless of if you are a furry."}]}]},{"attributes":{"id":"iicbsyf"},"components":[{"tagName":"span","type":"text","attributes":{"data-gs-mrk-fs":"true","id":"ic3taci"},"components":[{"type":"textnode","content":"I was advised I should probably make that distinction owned refers to Management+"}]}]},{"tagName":"p"}]},{"name":"About Block","classes":["gjs-t-border","about-block"],"components":[{"tagNa