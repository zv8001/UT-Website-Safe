utions for a greener future. Founded on April 24th 1942, Evergreen Research operates at the intersection of advanced scientific innovation and environmental stewardship, striving to balance technological progress with ecological preservation."}]},{"tagName":"p"}]},{"name":"Affiliate Footer","classes":["affiliate-footer"],"attributes":{"id":"ip8d8nb-2"},"components":[{"type":"link","name":"Button Link","classes":["gjs-t-button","affiliate-button"],"attributes":{"href":"https://www.roblox.com/communities/11031020/Evergreen-Research","id":"ivqdifs","aria-label":"Learn more about Evergreen Research","data-link-target":"contact"},"components":[{"type":"textnode","content":"Learn more"}],"hrefType":"url"}]}]},{"tagName":"article","name":"Affiliate Card","classes":["gjs-t-border","affiliate-card"],"attributes":{"id":"il36ns9-2-2"},"components":[{"name":"Affiliate Header","classes":["affiliate-header"],"attributes":{"id":"ihhqm5y-2-2"},"components":[{"name":"Affiliate Logo","classes":["affiliate-logo"],"components":[{"type":"image","name":"Affiliate Logo Image","resizable":{"ratioDefault":1},"classes":["affiliate-logo-image"],"attributes":{"src":"https://cdn.grapesjs.com/workspaces/cmhpistme05if12ma87sbd7ql/assets/918f6953-f4ad-484d-944b-6b63c42ba02c__image-9.png","alt":"Partner logo","loading":"lazy","id":"ifpr0dc-2-2-2-2"}}]},{"name":"Affiliate Info","classes":["affiliate-info"],"attributes":{"id":"iqh0z8b-2-2"},"components":[{"tagName":"h3","type":"heading","name":"Affiliate Name","classes":["affiliate-name"],"attributes":{"id":"ivpzk59-2-2"},"components":[{"type":"textnode","content":"Extreme Energy Inc"}]},{"tagName":"p","type":"text","name":"Affiliate Category","classes":["affiliate-category"],"attributes":{"id":"imv585z-2-2"},"components":[{"type":"textnode","content":"@VexTheProtogen"}]}]}]},{"name":"Affiliate Body","classes":["affiliate-body"],"attributes":{"id":"in70x0i-2-2"},"components":[{"tagName":"p","type":"text","name":"Affiliate Description","classes":["affiliate-description"],"attributes":{"id":"isd7469-2-2"},"components":[{"type":"textnode","content":"This is another group by the same Creator as UT (me vex) \n                "},{"tagName":"br","void":true,"attributes":{"data-gs-ib":""}},{"tagName":"br","void":true,"attributes":{"data-gs-ib":""}},{"type":"textnode","content":"Thought I should mention it here because it had UTPRC’s grandfather (EEPRC)\n                "},{"tagName":"br","void":true,"attributes":{"data-gs-ib":""}},{"tagName":"br","void":true,"attributes":{"data-gs-ib":""}},{"type":"textnode","content":"Extreme Energy Plasma Reactor Core (EEPRC) was my first game that gained some traction. \n                "},{"tagName":"br","void":true,"attributes":{"data-gs-ib":""}},{"tagName":"br","void":true,"attributes":{"data-gs-ib":""}},{"type":"textnode","content":"Then I stepped away from the group for a while in that time EEIURS born.\n                "},{"tagName":"br","void":true,"attributes":{"data-gs-ib":""}},{"tagName":"br","void":true,"attributes":{"data-gs-ib":""}},{"type":"textnode","content":"EEIURS had potential but ended up being a failure due to uncoordinated development and lack of motivation.\n                "},{"tagName":"br","void":true,"attributes":{"data-gs-ib":""}}]},{"tagName":"p","type":"text","attributes":{"id":"iiodhrh"},"components":[{"type":"textnode","content":"Farewell EEI"}]},{"tagName":"p"}]},{"name":"Affiliate Footer","classes":["affiliate-footer"],"attributes":{"id":"ip8d8nb-2-2"},"components":[{"type":"link","name":"Button Link","classes":["gjs-t-button","affiliate-button"],"attributes":{"href":"https://www.roblox.com/communities/16381439/Extreme-Energy-Inc#!/about","id":"ivqdifs-2","aria-label":"Learn more about Evergreen Research","data-link-target":"contact"},"components":[{"type":"textnode","content":"Learn more"}],"hrefType":"url"}]}]}]}]},{"tagName":"section","name":"CTA Section","classes":["cta-section"],"attributes":{"id":"itdks6k"},"components":[{"name":"CTA Container","classes":["gjs-t-border","cta-container"],"attributes":{"id":"i0thoai"},"components":[{"name":"CTA Copy","classes":["cta-copy"],"attributes":{"id":"igd7s5e"},"components":[{"name":"CTA Eyebrow","classes":["cta-eyebrow"],"attributes":{"id":"iqenhmv"},"components":[{"type":"image","name":"Sparkles Icon","resizable":{"ratioDefault":1},"classes":["sparkles-icon"],"attributes":{"src":"https://api.iconify.design/lucide-sparkles.svg?color=%23f4f4f5","alt":"","id":"iihp9cp"}},{"tagName":"span","type":"text","name":"Eyebrow Text","classes":["eyebrow-text"],"attributes":{"id":"iv7vhd4"},"components":[{"type":"textnode","content":"Get involved"}]}]},{"tagName":"h3","type":"heading","name":"CTA Title","classes":["cta-title"],"attributes":{"id":"ib4dq0a"},"components":[{"tagName":"span","type":"text","attributes":{"data-gs-mrk-fs":"true","id":"ikeyu6h"},"components":[{"type":"textnode","content":"Become an affiliate"}]}]},{"type":"text","attributes":{"id":"i6974iu"},"components":[{"tagName":"span","type":"text","attributes":{"data-gs-mrk-fs":"true","id":"i5mb76a"},"components":[{"type":"textnode","content":"Interested in becoming one of our affiliates? \n                "},{"tagName":"br","void":true,"attributes":{"data-gs-ib":""}},{"tagName":"br","void":true,"attributes":{"data-gs-ib":""}},{"type":"textnode","content":"Requirements:\n                "},{"tagName":"br","void":true,"attributes":{"data-gs-ib":""}},{"type":"textnode","content":"1. Community must have a Discord server\n                "},{"tagName":"br","void":true,"attributes":{"data-gs-ib":""}},{"type":"textnode","content":"2. Your roblox group must have over 250 members\n              "}]},{"tagName":"ol","type":"default","attributes":{"id":"ikvzpx8"},"components":[{"tagName":"li","type":"default","attributes":{"id":"iyxma96"},"components":[{"type":"text","attributes":{"id":"iaysrnk"},"components":[{"tagName":"span","type":"text","attributes":{"data-gs-mrk-fs":"true","id":"ibrbl15"},"components":[{"type":"textnode","content":"3. You must have an active development project"}]}]},{"tagName":"ol","type":"default","attributes":{"id":"icuk4zc"},"components":[{"tagName":"li","type":"text","attributes":{"id":"iwbvu3i"},"components":[{"tagName":"span","type":"text","attributes":{"data-gs-mrk-fs":"true","id":"iwjkmox"},"components":[{"type":"textnode","content":"4. You must have little to no punishment history at UT.\n                        "},{"tagName":"br","void":true,"attributes":{"data-gs-ib":""}},{"type":"textnode","content":"5. Your account group and Affiliates must not have stolen assets anywhere publicly visible.\n                      "}]}]}]}]}]},{"type":"default","attributes":{"id":"imgmya7"},"components":[{"tagName":"br","void":true}]},{"type":"default","attributes":{"id":"igeig83"},"components":[{"tagName":"span","type":"text","attributes":{"data-gs-mrk-fs":"true","id":"ifph8vx"},"components":[{"type":"textnode","content":"*Affiliates requested after 12/15/2025 are bound to these terms existing affiliates that were made before these rules do not have to unaffiliate from Unknown Technologies."}]}]},{"components":[{"tagName":"br","void":true}]},{"components":[{"tagName":"br","void":true}]},{"type":"text","attributes":{"id":"i950jr5"},"components":[{"type":"textnode","content":"Submitting an affiliate request does not guarantee acceptance. Your request may be denied for any reason. You will be contacted if we decide to move forward. Please do not contact us for updates. We will reach out to you if we believe a partnership is a good fit."}]},{"components":[{"tagName":"br","void":true}]},{"components":[{"tagName":"br","void":true}]},{"tagName":"ol","type":"default","attributes":{"id":"iyrua2n"},"components":[{"tagName":"li","type":"default","attributes":{"id":"ijvo3at"},"components":[{"tagName":"ol","type":"default","attributes":{"id":"i4b8bkh"},"components":[{"tagName":"li","type":"default","attributes":{"id":"immr3a2"},"components":[{"tagName":"ol","type":"default","a